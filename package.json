{
  "name": "estatisticas",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint .",
    "formata": "prettier --write .",
    "confere-formato": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:gerar": "drizzle-kit generate",
    "db:preparar": "tsx scripts/preparar-banco.ts",
    "importar-banco-antigo": "tsx scripts/importar-banco-antigo.ts",
    "importar-notas": "tsx scripts/importar-notas.ts",
    "avisar-buscadores": "tsx scripts/avisar-buscadores.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.3",
    "next": "16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.4",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
